<?xml version="1.0"?>
<!-- Escenario de monitoreo: terreno, árboles y un foco de incendio en (8, 5). -->
<sdf version="1.9">
  <world name="incendio">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>
    <!-- Empujes manuales desde la GUI o /world/incendio/wrench. El viento de la
         simulación lo aplica el sistema FuerzaViento del modelo. -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.65 0.72 0.8 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="terreno">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.35 0.45 0.25 1</ambient><diffuse>0.35 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://foco_incendio</uri>
      <name>foco_incendio</name>
      <pose>8 5 0 0 0 0</pose>
    </include>

    <model name="arbol_1"><static>true</static><pose>12 9 0 0 0 0</pose>
      <link name="link">
        <visual name="tronco"><pose>0 0 1 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.35 0.2 0.1 1</diffuse></material></visual>
        <visual name="copa"><pose>0 0 2.6 0 0 0</pose><geometry><sphere><radius>1.1</radius></sphere></geometry>
          <material><ambient>0.1 0.35 0.1 1</ambient><diffuse>0.1 0.35 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="arbol_2"><static>true</static><pose>3 10 0 0 0 0</pose>
      <link name="link">
        <visual name="tronco"><pose>0 0 1 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.35 0.2 0.1 1</diffuse></material></visual>
        <visual name="copa"><pose>0 0 2.6 0 0 0</pose><geometry><sphere><radius>1.1</radius></sphere></geometry>
          <material><ambient>0.1 0.35 0.1 1</ambient><diffuse>0.1 0.35 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="arbol_3"><static>true</static><pose>14 1 0 0 0 0</pose>
      <link name="link">
        <visual name="tronco"><pose>0 0 1 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.35 0.2 0.1 1</diffuse></material></visual>
        <visual name="copa"><pose>0 0 2.6 0 0 0</pose><geometry><sphere><radius>1.1</radius></sphere></geometry>
          <material><ambient>0.1 0.35 0.1 1</ambient><diffuse>0.1 0.35 0.1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
